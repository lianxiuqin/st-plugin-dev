{
  "name": "chat-stream-plugin",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "对话流式输出(打字机):后端 POST /api/chat-stream/send 转发 chat-plugin 的 chatStreamer 为 SSE;前端向 ui-chat-plugin 注册 stream transport;config.stream 可关回整回",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../agent_plugin_feat/bootstrap/src/cli/index.ts web-build --cwd .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cordis": "file:../../agent_plugin_feat/vendor/cordis"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "st": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "kind": "web",
      "path": "lib/index.cjs",
      "immed": true,
      "inject": ["ui-polish", "st-ui-slots", "ui-chat-plugin"]
    }
  }
}
