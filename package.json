{
  "name": "ui-chat-plugin",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "对话页渲染插件:默认气泡对话页 + window.__uiChat__ 分层扩展注册表(页面所有内容可被第三方插件替换/扩展)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../agent_plugin_feat/bootstrap/src/cli/index.ts web-build --cwd .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cordis": "file:../../agent_plugin_feat/vendor/cordis"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "st": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "kind": "web",
      "path": "lib/index.cjs",
      "immed": true,
      "inject": ["ui-polish", "st-ui-slots"]
    }
  }
}
